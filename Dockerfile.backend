# Base image
FROM python:3.12-slim

# Set working directory to the project root so relative paths work
WORKDIR /app

# Install system dependencies if required
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

# Create directory structure to match local setup
RUN mkdir -p /app/frontend/backend /app/models /app/data

# Copy requirements and install
COPY frontend/backend/requirements.txt /app/frontend/backend/
RUN pip install --no-cache-dir -r /app/frontend/backend/requirements.txt

# Copy the machine learning model
COPY models/model.sav /app/models/

# Copy the backend code
COPY frontend/backend /app/frontend/backend/

# Create a symlink for the SQLite database so we can persist it without masking the backend directory
RUN rm -f /app/frontend/backend/heart_disease.db && ln -s /app/data/heart_disease.db /app/frontend/backend/heart_disease.db

# Set the working directory to the backend so uvicorn runs correctly
WORKDIR /app/frontend/backend

# Expose port
EXPOSE 8000

# Command to run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
